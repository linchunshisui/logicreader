{
  "name": "logicreader",
  "version": "0.3.0",
  "private": true,
  "description": "逻辑阅读器 / LogicReader —— 会画逻辑图的本地文档阅读器",
  "author": "LogicReader",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:watch": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "build:win:full": "cross-env LR_FULL=1 electron-vite build && electron-builder --win --config electron-builder.yml",
    "build:unpack": "electron-vite build && electron-builder --win --dir --config electron-builder.yml",
    "trust:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/trust-windows.ps1",
    "launch:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch-doctor.ps1",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-shortcut.ps1",
    "postinstall": "node scripts/ensure-electron.mjs",
    "publish:local": "node scripts/publish-local.mjs",
    "publish:github": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-github.ps1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.286",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.5.1",
    "@e965/xlsx": "^0.20.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@xyflow/react": "^12.12.0",
    "d3-force": "^3.0.0",
    "docx-preview": "^0.4.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "elkjs": "^0.12.0",
    "fast-xml-parser": "^5.11.2",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "i18next": "^26.4.2",
    "immer": "^11.1.18",
    "jszip": "^3.10.2",
    "katex": "^0.18.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.4.3",
    "typescript": "^5.9.3",
    "unified": "11.0.0",
    "unist-util-visit": "^5.0.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4",
    "zustand": "^5.0.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller"
    ]
  }
}
