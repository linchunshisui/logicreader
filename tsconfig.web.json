{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@logicreader/shared": [
        "packages/shared/src/index.ts"
      ],
      "@logicreader/document-model": [
        "packages/document-model/src/index.ts"
      ],
      "@logicreader/graph-schema": [
        "packages/graph-schema/src/index.ts"
      ],
      "@/*": [
        "apps/renderer/src/*"
      ]
    },
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "apps/renderer/src/**/*.ts",
    "apps/renderer/src/**/*.tsx",
    "packages/*/src/**/*.ts"
  ]
}
